# Variables para la función de contacto (api/contact.ts).
# En producción se configuran en Vercel → Project → Settings → Environment Variables.
# Para probar en local con `vercel dev`, copia este archivo como .env (no se sube a git).

# Cuenta de Gmail que envía los correos
GMAIL_USER=consultings996@gmail.com
# Contraseña de aplicación de Google (16 caracteres). Se genera en
# https://myaccount.google.com/apppasswords (requiere verificación en dos pasos).
GMAIL_APP_PASSWORD=
# Destinatario de los mensajes (opcional; por defecto GMAIL_USER)
CONTACT_TO=

# URL pública del sitio (canonical, sitemap y vista previa en redes). Sin "/" al final.
VITE_SITE_URL=https://axl-web-site.vercel.app
